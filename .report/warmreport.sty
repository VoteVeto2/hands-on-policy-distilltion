% Shared design of the OPD reports: a warm palette, colour blocks, Libertinus
% fonts. Used by opd-report-en.tex (article) and opd-report-zh.tex (ctexart);
% each document sets \wrshorttitle and \algoname, and the zh one its CJK fonts.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{warmreport}[2026/10/20 Warm report design]

\RequirePackage[a4paper,margin=2.3cm,headheight=14pt,headsep=0.8cm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{libertinus-otf}  % Libertinus Serif, Sans, Mono and Math.
\RequirePackage[table]{xcolor}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,raster}
\RequirePackage{algpseudocode}
\RequirePackage{pgfplots}
\usepgfplotslibrary{groupplots}
\pgfplotsset{compat=1.18}
\RequirePackage[round]{natbib}
\RequirePackage{hyperref}

% ---- Palette -------------------------------------------------------------
\definecolor{wr-text}{HTML}{2B211D}        % body text, a warm near-black
\definecolor{wr-brown}{HTML}{4A2C21}       % headings
\definecolor{wr-rust}{HTML}{A33B20}        % links, run-in headings
\definecolor{wr-terracotta}{HTML}{C9573A}  % main accent
\definecolor{wr-orange}{HTML}{E07B24}      % plot series 2
\definecolor{wr-amber}{HTML}{E3A43A}       % second accent
\definecolor{wr-ochre}{HTML}{B9811C}
\definecolor{wr-wine}{HTML}{842C3A}        % plot series 1
\definecolor{wr-sage}{HTML}{6F7D4E}
\definecolor{wr-taupe}{HTML}{8B7768}       % rules, captions, header
\definecolor{wr-sand}{HTML}{F3E4D0}
\definecolor{wr-peach}{HTML}{FCEADB}
\definecolor{wr-cream}{HTML}{FFF8EF}
\AtBeginDocument{\color{wr-text}}

\hypersetup{colorlinks, linkcolor=wr-rust, citecolor=wr-rust,
  urlcolor=wr-terracotta, filecolor=wr-rust}

% ---- Page ----------------------------------------------------------------
\newcommand{\wrshorttitle}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize\color{wr-taupe}\wrshorttitle}
\fancyhead[R]{\sffamily\footnotesize\bfseries\color{wr-terracotta}\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\headrule}{{\color{wr-sand}%
  \hrule width\headwidth height\headrulewidth \vskip-\headrulewidth}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\footnotesize\bfseries\color{wr-terracotta}\thepage}}

% ---- Headings: a rounded number badge, sans-serif titles ----------------
\DeclareRobustCommand{\wrbadge}[1]{\tcbox[on line, colback=wr-terracotta,
  colframe=wr-terracotta, boxrule=0pt, arc=1.2mm, left=1.5mm, right=1.5mm,
  top=0.6mm, bottom=0.6mm, coltext=white, fontupper=\sffamily\bfseries]{#1}}
\@ifclassloaded{ctexart}{%
  \ctexset{
    section={format=\sffamily\bfseries\Large\color{wr-brown}\raggedright,
      numberformat=\wrbadge, aftername=\hspace{0.6em},
      beforeskip=3ex plus 1ex minus .2ex, afterskip=1.6ex plus .2ex},
    paragraph={format=\sffamily\bfseries\color{wr-rust}, afterskip=0.6em},
  }%
}{%
  \RequirePackage{titlesec}
  \titleformat{\section}{\sffamily\bfseries\Large\color{wr-brown}}
    {\wrbadge{\thesection}}{0.6em}{}
  \titlespacing*{\section}{0pt}{3ex plus 1ex minus .2ex}{1.6ex plus .2ex}
  \titleformat{\paragraph}[runin]{\sffamily\bfseries\color{wr-rust}}{}{0pt}{}
  \titlespacing*{\paragraph}{0pt}{1.4ex plus .5ex minus .2ex}{0.6em}
}

% ---- Lists, captions, tables ---------------------------------------------
\setlist[itemize]{label={\color{wr-terracotta}\textbullet}, leftmargin=*,
  itemsep=2pt, topsep=3pt}
\setlist[enumerate]{leftmargin=*, itemsep=2pt, topsep=3pt}
\captionsetup{font=small, labelfont={sf,bf,color=wr-terracotta},
  labelsep=quad}
\arrayrulecolor{wr-taupe}
\setlength{\aboverulesep}{0pt}  % Lets \rowcolor fill up to the rules.
\setlength{\belowrulesep}{0pt}
\renewcommand{\arraystretch}{1.25}
\newcommand{\headrow}{\rowcolor{wr-sand}}
\setlength{\emergencystretch}{2em}  % Fewer overfull lines around inline math.
% Let a table and a figure share the top of a page.
\renewcommand{\topfraction}{0.85}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.8}
\setcounter{topnumber}{3}

% ---- Title banner and abstract -------------------------------------------
% \wrtitle{kicker}{title}{subtitle}{line under the banner}
\newcommand{\wrtitle}[4]{%
  \thispagestyle{plain}%
  \begin{tcolorbox}[enhanced, boxrule=0pt, arc=3mm, left=9mm, right=9mm,
      top=7mm, bottom=7mm,
      interior style={left color=wr-rust, right color=wr-terracotta!80!wr-amber},
      overlay={\fill[white, opacity=0.09]
          ([xshift=-2.2cm, yshift=-0.6cm]frame.north east) circle (2.6cm);
        \fill[white, opacity=0.07]
          ([xshift=-0.4cm, yshift=0.4cm]frame.south east) circle (1.5cm);}]
    {\sffamily\small\color{wr-sand}\addfontfeatures{LetterSpace=8}#1}\par
    \vspace{3mm}
    {\sffamily\bfseries\huge\color{white}#2}\par\vspace{2mm}
    {\sffamily\Large\color{wr-cream}#3}
  \end{tcolorbox}
  {\sffamily\small\color{wr-taupe}#4}\par\vspace{5mm}}

\newtcolorbox{wrabstract}[1]{enhanced, colback=wr-sand!65,
  colframe=wr-terracotta, boxrule=0pt, leftrule=1.3mm, arc=2mm,
  left=6mm, right=6mm, top=4mm, bottom=4mm, after skip=6mm,
  before upper={{\sffamily\bfseries\color{wr-terracotta}#1}\par\smallskip}}

% ---- Colour blocks -------------------------------------------------------
% A key result, with its title on a tab.
\newtcolorbox{keybox}[1]{enhanced, colback=wr-peach!70,
  colframe=wr-terracotta, boxrule=0.8pt, arc=2mm, title={#1},
  fonttitle=\sffamily\bfseries\small, coltitle=white,
  colbacktitle=wr-terracotta,
  attach boxed title to top left={xshift=5mm, yshift*=-\tcboxedtitleheight/2},
  boxed title style={boxrule=0pt, arc=1mm},
  top=4mm, bottom=3mm, left=5mm, right=5mm, before skip=4mm, after skip=4mm}

% A side note, kept on one page: tinted background, coloured bar on the left.
% \begin{notebox}[colour]{title}
\newtcolorbox{notebox}[2][wr-amber]{enhanced, colback=wr-cream,
  colframe=#1, boxrule=0pt, leftrule=1.2mm, arc=1.5mm, left=5mm, right=5mm,
  top=3mm, bottom=3mm, before skip=3mm, after skip=3mm,
  before upper={{\sffamily\bfseries\color{#1!75!wr-brown}#2}\hspace{0.6em}}}

% A key finding, kept on one page.
\newtcolorbox{findbox}[1]{enhanced, colback=wr-peach!45, colframe=wr-rust,
  boxrule=0pt, leftrule=1.2mm, arc=1.5mm, left=5mm, right=5mm, top=3mm,
  bottom=3mm, before skip=3mm, after skip=3mm,
  before upper={{\sffamily\bfseries\color{wr-rust}#1}\hspace{0.6em}}}

% A headline number over a short caption: \begin{stat}{colour}{number}
\newtcolorbox{stat}[2]{enhanced, colback=#1!9, colframe=#1!9, boxrule=0pt,
  arc=2mm, halign=center, valign=top, left=2mm, right=2mm, top=2.5mm,
  bottom=2.5mm, fontupper=\footnotesize,
  before upper={{\sffamily\bfseries\Large\color{#1}#2}\par\smallskip}}

% An algorithm, numbered, floating.
\newcommand{\algoname}{Algorithm}
\newtcolorbox[auto counter]{algobox}[2][]{enhanced, float=tbp,
  colback=wr-cream, colframe=wr-brown, boxrule=0.6pt, arc=2mm,
  title={\algoname~\thetcbcounter\hspace{0.8em}#2},
  fonttitle=\sffamily\bfseries\small, colbacktitle=wr-brown, coltitle=white,
  left=4mm, right=4mm, top=2mm, bottom=2mm, #1}

% A card in a raster of takeaways: \begin{card}{colour}{title}
\newtcolorbox{card}[2]{enhanced, colback=#1!7, colframe=#1, boxrule=0.5pt,
  arc=2mm, title={#2}, fonttitle=\sffamily\bfseries, coltitle=white,
  colbacktitle=#1, halign=flush left, halign title=flush left,
  left=4mm, right=4mm, top=2mm, bottom=3mm}

% Commands and paths.
\newtcolorbox{codebox}{enhanced, colback=wr-cream, colframe=wr-sand,
  boxrule=0.8pt, arc=1.5mm, left=4mm, right=4mm, top=2mm, bottom=2mm,
  fontupper=\ttfamily\small}

% ---- Plots ---------------------------------------------------------------
\pgfplotsset{
  every axis/.append style={axis line style={wr-taupe}, tick style={wr-taupe},
    major grid style={dashed, wr-taupe!45},
    axis background/.style={fill=wr-cream}},
}
